<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FAQ List</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <style>
        body {
            font-family: 'Arial', sans-serif;
            background: linear-gradient(135deg, #6e8efb, #a777e3);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
        }
        .container {
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
            width: 90%;
            max-width: 600px;
        }
        h1 {
            text-align: center;
            color: #4a47a3;
            margin-bottom: 20px;
        }
        .search-box {
            width: 100%;
            padding: 10px;
            border-radius: 5px;
            border: 1px solid #ccc;
            margin-bottom: 15px;
            font-size: 16px;
        }
        .add-faq {
            display: block;
            background: #4a47a3;
            color: white;
            text-align: center;
            padding: 10px;
            border-radius: 5px;
            font-size: 16px;
            margin-bottom: 15px;
            transition: 0.3s;
            text-decoration: none;
        }
        .add-faq:hover {
            background: #372f92;
        }
        .faq-list {
            list-style: none;
            padding: 0;
        }
        .faq-item {
            background: #f9f9f9;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 10px;
            box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
            transition: all 0.3s;
            cursor: pointer;
        }
        .faq-item:hover {
            background: #e0e0e0;
        }
        .faq-answer {
            display: none;
            margin-top: 8px;
            color: #555;
            font-size: 14px;
        }
        select {
            margin-top: 10px;
            padding: 8px;
            border-radius: 5px;
            border: 1px solid #ccc;
            font-size: 14px;
            width: 100%;
        }
        .translation-result {
            margin-top: 10px;
            padding: 10px;
            background-color: #e9ecef;
            border-left: 5px solid #007bff;
            display: none;
        }
        .loader {
            display: none;
            margin-top: 10px;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>FAQs</h1>
        <input type="text" class="search-box" placeholder="Search FAQs..." onkeyup="searchFAQs()">
        <a href="/add-faq" class="add-faq">Add FAQ</a>
        <ul class="faq-list" id="faq-list">
            <% faqs.forEach(faq => { %>
                <li class="faq-item" onclick="toggleAnswer('<%= faq._id %>')">
                    <strong><%= faq.question %></strong>
                    <p id="answer-<%= faq._id %>" class="faq-answer"><%= faq.answer %></p>
                    <select onchange="translateFAQ('<%= faq._id %>', this.value)">
                        <option value="">Select Language</option>
                        <% supportedLanguages.forEach(lang => { %>
                            <option value="<%= lang %>"><%= lang.toUpperCase() %></option>
                        <% }) %>
                    </select>
                    <div class="loader" id="loader-<%= faq._id %>"><i class="fas fa-spinner fa-spin"></i> Translating...</div>
                    <div class="translation-result" id="result-<%= faq._id %>"></div>
                </li>
            <% }) %>
        </ul>
    </div>
    
    <script>
        function toggleAnswer(id) {
            const answer = document.getElementById(`answer-${id}`);
            answer.style.display = answer.style.display === "block" ? "none" : "block";
        }

        async function translateFAQ(faqId, lang) {
            const resultDiv = document.getElementById(`result-${faqId}`);
            const loader = document.getElementById(`loader-${faqId}`);
            
            if (lang) {
                resultDiv.style.display = 'none';
                loader.style.display = 'block';
                
                const response = await fetch(`/translate/${faqId}?lang=${lang}`);
                const data = await response.json();
                
                loader.style.display = 'none';
                resultDiv.innerHTML = `<strong>Translated Question:</strong> ${data.question}<br><strong>Translated Answer:</strong> ${data.answer}`;
                resultDiv.style.display = 'block';
            } else {
                resultDiv.style.display = 'none';
            }
        }
        
        function searchFAQs() {
            let input = document.querySelector('.search-box').value.toLowerCase();
            let faqs = document.querySelectorAll('.faq-item');
            
            faqs.forEach(faq => {
                let question = faq.querySelector('strong').innerText.toLowerCase();
                faq.style.display = question.includes(input) ? "block" : "none";
            });
        }
    </script>
</body>
</html>