<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add FAQ</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #6e8efb, #a777e3);
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        .container {
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
            width: 90%;
            max-width: 500px;
            text-align: center;
        }

        h1 {
            color: #4a47a3;
            margin-bottom: 15px;
        }

        label {
            font-weight: bold;
            display: block;
            margin: 10px 0 5px;
            text-align: left;
        }

        input, textarea {
            width: 100%;
            padding: 10px;
            margin: 5px 0 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 16px;
            transition: all 0.3s;
        }

        input:focus, textarea:focus {
            border-color: #4a47a3;
            outline: none;
            box-shadow: 0 0 8px rgba(74, 71, 163, 0.3);
        }

        #charCount {
            font-size: 14px;
            text-align: right;
            color: gray;
        }

        button {
            background: #4a47a3;
            color: white;
            border: none;
            padding: 12px;
            font-size: 16px;
            border-radius: 5px;
            cursor: pointer;
            width: 100%;
            margin-top: 10px;
            transition: 0.3s;
        }

        button:hover {
            background: #372f92;
        }

        .back-link {
            display: inline-block;
            margin-top: 15px;
            text-decoration: none;
            color: #4a47a3;
            font-weight: bold;
            transition: 0.3s;
        }

        .back-link:hover {
            color: #372f92;
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Add FAQ</h1>
        <form action="/add-faq" method="POST">
            <label for="question">Question:</label>
            <input type="text" id="question" name="question" required placeholder="Enter your question">

            <label for="answer">Answer:</label>
            <textarea id="answer" name="answer" required placeholder="Enter the answer" rows="4"></textarea>
            <div id="charCount">0/500</div>

            <button type="submit">Submit</button>
        </form>
        <a href="/" class="back-link">Back to FAQs</a>
    </div>

    <script>
        const answerField = document.getElementById("answer");
        const charCount = document.getElementById("charCount");

        answerField.addEventListener("input", function() {
            const maxLength = 500;
            let length = answerField.value.length;
            charCount.textContent = `${length}/${maxLength}`;

            if (length > maxLength) {
                charCount.style.color = "red";
            } else {
                charCount.style.color = "gray";
            }
        });
    </script>
</body>
</html>
